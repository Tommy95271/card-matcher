# Notion API 整合設定
# 1. 前往 https://www.notion.so/my-integrations 建立 Integration 取得 API Key
NOTION_API_KEY=ntn_your_integration_secret_here

# 2. 在 Notion 建立一個母頁面，並授權該 Integration
# 複製母頁面網址中的 32 位元 PAGE_ID
NOTION_PARENT_PAGE_ID=your_parent_page_id_here

# 3. 執行 npm run seed:notion 後，系統會自動生成 DATABASE_ID
NOTION_DATABASE_ID=

# Google Apps Script (GAS) 中繼站 Webhook
VITE_GAS_WEBHOOK_URL=https://script.google.com/macros/s/your_gas_script_id/exec

# Firebase 雲端即時同步設定
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

