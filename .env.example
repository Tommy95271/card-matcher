# Notion API 整合設定
# 1. 前往 https://www.notion.so/my-integrations 建立 Integration 取得 API Key
NOTION_API_KEY=ntn_your_integration_secret_here

# 2. 在 Notion 建立一個母頁面，並授權該 Integration
# 複製母頁面網址中的 32 位元 PAGE_ID
NOTION_PARENT_PAGE_ID=your_parent_page_id_here

# 3. 執行 npm run seed:notion 後，系統會自動生成 DATABASE_ID
NOTION_DATABASE_ID=

# Firebase 雲端即時同步設定
VITE_FIREBASE_API_KEY=AIzaSyAvpRxdpI5piKkBwmSRCqhS-HIFC2Sr08s
VITE_FIREBASE_AUTH_DOMAIN=card-matcher-2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=card-matcher-2026
VITE_FIREBASE_STORAGE_BUCKET=card-matcher-2026.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=475785989950
VITE_FIREBASE_APP_ID=1:475785989950:web:a000298f1601ba9558666f
